{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultRoot", "policies", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "resultRoot": {"const": "target/trace-model-routing"},
    "policies": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/solOnlyPolicy"}, {"$ref": "#/$defs/terraSolPolicy"}, {"$ref": "#/$defs/lunaTerraSolPolicy"}], "items": false},
    "cases": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "route": {"type": "string", "pattern": "^gpt-5\\.6-(luna|terra|sol)/(low|medium|high)$"},
    "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["name", "enabled", "routes"], "properties": {"name": {"enum": ["sol-only", "terra-sol", "luna-terra-sol"]}, "enabled": {"type": "boolean"}, "disabledReason": {"type": "string", "minLength": 1}, "routes": {"$ref": "#/$defs/routeTable"}}},
    "routeTable": {"type": "object", "additionalProperties": false, "required": ["discovery", "triage", "narrowFix", "sharedFix", "ordinaryVerify", "escalatedVerify"], "properties": {"discovery": {"$ref": "#/$defs/routes"}, "triage": {"$ref": "#/$defs/routes"}, "narrowFix": {"$ref": "#/$defs/routes"}, "sharedFix": {"$ref": "#/$defs/routes"}, "ordinaryVerify": {"$ref": "#/$defs/routes"}, "escalatedVerify": {"$ref": "#/$defs/routes"}}},
    "solOnlyPolicy": {"allOf": [{"$ref": "#/$defs/policy"}, {"properties": {"name": {"const": "sol-only"}, "enabled": {"const": true}, "routes": {"properties": {"discovery": {"const": ["gpt-5.6-sol/high"]}, "triage": {"const": ["gpt-5.6-sol/high"]}, "narrowFix": {"const": ["gpt-5.6-sol/high"]}, "sharedFix": {"const": ["gpt-5.6-sol/high"]}, "ordinaryVerify": {"const": ["gpt-5.6-sol/high"]}, "escalatedVerify": {"const": ["gpt-5.6-sol/high"]}}}}}]},
    "terraSolPolicy": {"allOf": [{"$ref": "#/$defs/policy"}, {"properties": {"name": {"const": "terra-sol"}, "enabled": {"const": true}, "routes": {"properties": {"discovery": {"const": ["gpt-5.6-terra/low"]}, "triage": {"const": ["gpt-5.6-terra/medium", "gpt-5.6-sol/high"]}, "narrowFix": {"const": ["gpt-5.6-terra/medium", "gpt-5.6-sol/high"]}, "sharedFix": {"const": ["gpt-5.6-sol/high"]}, "ordinaryVerify": {"const": ["gpt-5.6-terra/medium"]}, "escalatedVerify": {"const": ["gpt-5.6-sol/high"]}}}}}]},
    "lunaTerraSolPolicy": {"allOf": [{"$ref": "#/$defs/policy"}, {"required": ["disabledReason"], "properties": {"name": {"const": "luna-terra-sol"}, "enabled": {"const": false}, "routes": {"properties": {"discovery": {"const": ["gpt-5.6-luna/low", "gpt-5.6-terra/low"]}, "triage": {"const": ["gpt-5.6-terra/medium", "gpt-5.6-sol/high"]}, "narrowFix": {"const": ["gpt-5.6-terra/medium", "gpt-5.6-sol/high"]}, "sharedFix": {"const": ["gpt-5.6-sol/high"]}, "ordinaryVerify": {"const": ["gpt-5.6-terra/medium"]}, "escalatedVerify": {"const": ["gpt-5.6-sol/high"]}}}}}]},
    "fqcn": {"type": "string", "pattern": "^(?:[A-Za-z_$][A-Za-z0-9_$]*\\.)+[A-Za-z_$][A-Za-z0-9_$]*$"},
    "frontier": {"type": "object", "additionalProperties": false, "required": ["frame", "field"], "properties": {"frame": {"type": "integer", "minimum": 0}, "field": {"type": "string", "minLength": 1}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^src/test/resources/traces/"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "rom": {"type": "object", "additionalProperties": false, "required": ["property", "sha1"], "properties": {"property": {"enum": ["sonic1.rom.path", "sonic2.rom.path", "s3k.rom.path"]}, "sha1": {"type": "string", "pattern": "^[0-9A-F]{40}$"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["id", "baseCommit", "testClass", "game", "zone", "complexity", "startingFrontier", "fixtures", "rom", "targetCommand", "verificationClasses", "historicalFailureConfirmed"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "testClass": {"$ref": "#/$defs/fqcn"}, "game": {"enum": ["s1", "s2", "s3k"]}, "zone": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "complexity": {"enum": ["narrow", "shared", "deep"]}, "startingFrontier": {"$ref": "#/$defs/frontier"}, "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}}, "rom": {"$ref": "#/$defs/rom"}, "targetCommand": {"type": "string", "pattern": "^mvn .*-D(sonic1|sonic2|s3k)\\.rom\\.path=<ROM_PATH>.*$"}, "verificationClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fqcn"}}, "historicalFailureConfirmed": {"const": true}}, "allOf": [{"if": {"properties": {"game": {"const": "s1"}}}, "then": {"properties": {"testClass": {"pattern": "^com\\.openggf\\.tests\\.trace\\.s1\\."}, "verificationClasses": {"const": ["com.openggf.tests.trace.s1.TestS1Ghz1TraceReplay"]}, "rom": {"properties": {"property": {"const": "sonic1.rom.path"}, "sha1": {"const": "69E102855D4389C3FD1A8F3DC7D193F8EEE5FE5B"}}}, "targetCommand": {"pattern": "-Dsonic1\\.rom\\.path=<ROM_PATH>"}}}}, {"if": {"properties": {"game": {"const": "s2"}}}, "then": {"properties": {"testClass": {"pattern": "^com\\.openggf\\.tests\\.trace\\.s2\\."}, "verificationClasses": {"const": ["com.openggf.tests.trace.s2.TestS2Ehz1TraceReplay"]}, "rom": {"properties": {"property": {"const": "sonic2.rom.path"}, "sha1": {"const": "8BCA5DCEF1AF3E00098666FD892DC1C2A76333F9"}}}, "targetCommand": {"pattern": "-Dsonic2\\.rom\\.path=<ROM_PATH>"}}}}, {"if": {"properties": {"game": {"const": "s3k"}}}, "then": {"properties": {"testClass": {"pattern": "^com\\.openggf\\.tests\\.trace\\.s3k\\."}, "verificationClasses": {"const": ["com.openggf.tests.TestS3kAiz1SkipHeadless", "com.openggf.tests.TestSonic3kLevelLoading", "com.openggf.game.sonic3k.TestSonic3kBootstrapResolver", "com.openggf.game.sonic3k.TestSonic3kDecodingUtils"]}, "rom": {"properties": {"property": {"const": "s3k.rom.path"}, "sha1": {"const": "CFBF98C36C776677290A872547AC47C53D2761D6"}}}, "targetCommand": {"pattern": "-Ds3k\\.rom\\.path=<ROM_PATH>"}}}}]}
  }
}
