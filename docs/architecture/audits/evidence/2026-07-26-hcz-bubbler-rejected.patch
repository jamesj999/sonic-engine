+    protected <T extends AbstractObjectInstance> T spawnLowestFreeChildForCurrentDispatch(
+            java.util.function.Supplier<T> factory) {
+        ObjectServices svc = services();
+        ObjectManager om = svc.objectManager();
+        if (om == null || ObjectConstructionContext.isProbeConstruction()) {
+            return ObjectConstructionContext.construct(svc, factory);
+        }
+        if (ObjectConstructionContext.isRewindActiveRestore()) {
+            return ObjectConstructionContext.construct(svc, () -> {
+                T child = factory.get();
+                om.registerRewindReconstructionChild(child);
+                return child;
+            });
+        }
+        return om.createLowestFreeDynamicObjectForCurrentDispatch(factory);
+    }
